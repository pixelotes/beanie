# Default time zone for get_datetime
BEANIE_TIMEZONE=Europe/Madrid
# Origins allowed via CORS (e.g. https://chat.example.com). Empty: no CORS.
BEANIE_CORS_ORIGINS=
# If set, HTTP mode requires "Authorization: Bearer <token>"
BEANIE_TOKEN=
# Without a token beanie only listens on loopback; 1 lets it listen elsewhere (docker-compose sets it)
BEANIE_INSECURE_NO_TOKEN=
# web_search backends in order (exa, tavily, jina, duckduckgo). Empty: DuckDuckGo only
BEANIE_SEARCH=
EXA_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
